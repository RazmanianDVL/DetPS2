<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- Determinism & Performance friendly settings -->
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>
    <!-- Not PublishAot: EeJit uses System.Reflection.Emit.DynamicMethod (incompatible with
         Native AOT), and publish.ps1 does a framework-dependent publish, not AOT. Setting
         PublishAot here only had the side effect of disabling reflection-based JSON
         serialization for every Release build/run, breaking user-media.json / config loading. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>

    <!-- Strong determinism hints -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- For later: Silk.NET for windowing/input when we get to graphics -->
    <!-- <PackageReference Include="Silk.NET" Version="2.22.0" /> -->
  </ItemGroup>

</Project>
