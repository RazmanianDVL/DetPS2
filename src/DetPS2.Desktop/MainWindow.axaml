<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DetPS2.Desktop.MainWindow"
        Title="DetPS2Sharp — Game Library"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="520"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Menu: File light; Options for everything else; Emulation for play controls -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="Load _ISO…" Click="OnLoadIsoClick" HotKey="Ctrl+I" />
                <MenuItem Header="Load _ELF…" Click="OnLoadElfClick" HotKey="Ctrl+E" />
                <Separator />
                <MenuItem Header="_Save State…" Click="OnSaveStateClick" HotKey="Ctrl+S" />
                <MenuItem Header="_Load State…" Click="OnLoadStateClick" HotKey="Ctrl+L" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" HotKey="Alt+F4" />
            </MenuItem>

            <MenuItem Header="_Options">
                <MenuItem Header="_General…" Click="OnOptionsGeneralClick" HotKey="Ctrl+," />
                <MenuItem Header="G_raphics…" Click="OnOptionsGraphicsClick" />
                <MenuItem Header="_Controllers…" Click="OnOptionsControllersClick" />
                <MenuItem Header="_Emulation…" Click="OnOptionsEmulationClick" />
                <MenuItem Header="_Audio…" Click="OnOptionsAudioClick" />
                <MenuItem Header="_Metadata…" Click="OnOptionsMetadataClick" />
                <MenuItem Header="A_dvanced…" Click="OnOptionsAdvancedClick" />
            </MenuItem>

            <MenuItem Header="_Emulation">
                <MenuItem Header="_Boot selected" Click="OnBootSelectedClick" HotKey="F2" />
                <MenuItem Header="_Run / Resume" Click="OnRunClick" HotKey="F5" />
                <MenuItem Header="_Pause" Click="OnPauseClick" HotKey="F6" />
                <MenuItem Header="_Stop &amp; close game window" Click="OnStopEmulationClick" HotKey="F9" />
                <Separator />
                <MenuItem Header="Show _game window" Click="OnShowGameWindowClick" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About…" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- Content: game library ONLY -->
        <Border Grid.Row="1" Background="#0e0e14" Margin="0"
                DragDrop.AllowDrop="True" x:Name="LibraryDropZone">
            <Panel>
            <StackPanel x:Name="EmptyLibraryHint" IsVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="10" MaxWidth="420">
                <TextBlock Text="🎮" FontSize="48" HorizontalAlignment="Center" Opacity="0.5" />
                <TextBlock Text="No games in your library yet" FontSize="16" FontWeight="SemiBold"
                           Foreground="#ccc" HorizontalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="Drag &amp; drop a folder or ISO here, or go Options → General → Set library path…"
                           FontSize="12" Foreground="#888" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
            <ListBox x:Name="LibraryList"
                     DoubleTapped="OnLibraryDoubleTapped"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="16"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="160" Height="220" Margin="8" Padding="8"
                                Background="#1a1a24" BorderBrush="#333" BorderThickness="1"
                                CornerRadius="8">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Height="140" Background="#0a0a10"
                                        CornerRadius="4" Margin="0,0,0,8" ClipToBounds="True">
                                    <Panel>
                                        <TextBlock Text="🎮" FontSize="36"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.35"
                                                   IsVisible="{Binding ShowPlaceholder}" />
                                        <Image Source="{Binding Cover}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding HasCover}" />
                                    </Panel>
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="#eee" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="10" Foreground="#666"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Panel>
        </Border>

        <!-- Thin status line only (no LOG panel, no sidebar) -->
        <Border Grid.Row="2" Padding="12,6" Background="#1a1a22">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#aaa" FontSize="12" />
        </Border>
    </Grid>
</Window>
