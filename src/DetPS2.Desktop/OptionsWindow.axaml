<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DetPS2.Desktop.OptionsWindow"
        Title="Options"
        Width="720" Height="560"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Grid ColumnDefinitions="200,*" Margin="0">
        <!-- Category navigation -->
        <Border Grid.Column="0" Background="#14141c" BorderBrush="#333" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="OPTIONS" FontWeight="Bold" FontSize="13"
                           Foreground="#888" Margin="16,16,16,8" />
                <ListBox x:Name="CategoryList" Margin="8,0,8,16"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnCategorySelectionChanged">
                    <ListBoxItem Tag="General" Content="General" />
                    <ListBoxItem Tag="Graphics" Content="Graphics" />
                    <ListBoxItem Tag="Controllers" Content="Controllers" />
                    <ListBoxItem Tag="Emulation" Content="Emulation" />
                    <ListBoxItem Tag="Audio" Content="Audio" />
                    <ListBoxItem Tag="Metadata" Content="Metadata" />
                    <ListBoxItem Tag="Advanced" Content="Advanced" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content host -->
        <Border Grid.Column="1" Background="#1a1a22" Padding="20">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="ContentHost" />
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Spacing="8" Margin="0,16,0,0">
                    <Button x:Name="CloseButton" Content="Close" Width="100" IsDefault="True"
                            Click="OnCloseClick" Padding="10,6" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
